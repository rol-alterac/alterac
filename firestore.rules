rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAutorizado() {
      return request.auth != null && request.auth.uid in [
        "WoeffsOhO1Rcbpz3bF0xwTcc0Lb2",
        "i0xj7H2rUZhQo2MjwjVq8zYszwH2"
      ];
    }

    match /pins/{pinId} {
      allow read: if true;
      allow write, delete: if esAutorizado();
    }

    match /dibujos/{dibujoId} {
      allow read: if true;
      allow write, delete: if esAutorizado();
    }
  }
}
